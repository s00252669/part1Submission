@baseUrl = http://localhost:3000/api/v1
@apiKey = pcbuilder-secret-key

########################################
# SEED DATA (POST with correct data → 201)
########################################

# @name cpuAmd
POST {{baseUrl}}/components HTTP/1.1
content-type: application/json
x-api-key: {{apiKey}}

{ "name": "Ryzen 5 9600X", "type": "CPU", "brand": "AMD", "price": 229, "wattage": 65, "socket": "AM5" }

